# Copy this file to .env and provide SMTP credentials for sign-in verification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comma-separated account emails allowed to review reported comments.
COMMENT_MODERATOR_EMAILS=

# Optional: set the HTTP server port.
PORT=5000
